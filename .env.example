# Fourier Analysis Development Environment
# Copy to .env and fill in values.

# ---------------------------------------------------------------------------
# MongoDB credentials
# ---------------------------------------------------------------------------
# MONGO_USER  — admin username for the mongo instance (default: fourier-admin).
# MONGO_PASSWORD — admin password.
#   * Dev:   defaults to the unsafe sentinel `fourier-dev-only` if unset
#            (see docker-compose.yml — the `:-` shell-style default).
#   * Prod:  REQUIRED — `docker-compose.prod.yml` uses the `:?` form which
#            makes the compose stack refuse to start when the var is unset.
# Rotate the prod credential through the deploy host's shell environment;
# never commit the literal to tracked source.
MONGO_USER=fourier-admin
MONGO_PASSWORD=fourier-dev-only

# ---------------------------------------------------------------------------
# MongoDB connection — direct verified-TLS to production (no SSH tunnel needed)
# ---------------------------------------------------------------------------
# MONGO_URI=mongodb://fourier-admin:<password>@mbabb.fridayinstitute.net:27017/fourier?tls=true&tlsCAFile=/path/to/mongo-ca.pem&authSource=admin
#   * Copy ./ssl/mongo-ca.pem from the deploy host to a local path and point
#     tlsCAFile at it. The prod leaf's SANs cover mbabb.fridayinstitute.net
#     (see docs/precepts/infra/tls.md — staged at docs/tranches/C/infra/tls.md);
#     full chain + hostname verification then applies. NEVER tlsAllowInvalid*.

# Fallback: local Docker mongo (started via docker compose up mongo)
MONGO_URI=mongodb://localhost:27017/fourier

# ---------------------------------------------------------------------------
# API surface
# ---------------------------------------------------------------------------
# ADMIN_TOKEN — bearer token guarding /admin/* routes (gallery moderation).
ADMIN_TOKEN=dev

# CORS_ORIGINS — comma-separated allow-list for the FastAPI CORS middleware.
# CORS_ORIGINS=https://fourier.babb.dev

# ---------------------------------------------------------------------------
# Port assignments
# ---------------------------------------------------------------------------
# API_PORT — host port the backend binds (default: 8000).
# WEB_PORT — host port the Vite dev server binds (default: 3000).
# HTTP_PORT — host port the prod nginx binds (default: 8100, loopback only).
# API_PORT=8000
# WEB_PORT=3000
# HTTP_PORT=8100

# ---------------------------------------------------------------------------
# Frontend build args (prod compose forwards these into the image)
# ---------------------------------------------------------------------------
# VITE_API_URL — absolute API base for the SPA when not same-origin.
# VITE_BASE_URL — public base path (default: /).
# VITE_API_URL=
# VITE_BASE_URL=/
