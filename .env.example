# Fourier Analysis Development Environment
# Copy to .env and fill in values.

# MongoDB connection — direct TLS to production (no SSH tunnel needed)
# MONGO_URI=mongodb://fourier-admin:<password>@mbabb.friday.institute:27017/fourier?tls=true&tlsAllowInvalidCertificates=true&authSource=admin

# Fallback: local Docker mongo (started via docker compose up mongo)
MONGO_URI=mongodb://localhost:27017/fourier

ADMIN_TOKEN=dev
