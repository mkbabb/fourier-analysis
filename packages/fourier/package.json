{
    "name": "@mkbabb/fourier",
    "version": "0.1.0",
    "description": "Fourier series of closed curves: spectra, partial sums, epicycle chains, and a small client for the fourier.babb.dev API.",
    "license": "MIT",
    "author": "Mike Babb",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mkbabb/fourier-analysis.git",
        "directory": "packages/fourier"
    },
    "homepage": "https://fourier.babb.dev",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:watch": "tsc -p tsconfig.build.json --watch",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run --maxWorkers=2",
        "prepublishOnly": "npm run build",
        "test:live": "vitest run --config vitest.live.config.ts --maxWorkers=1"
    },
    "devDependencies": {
        "@types/node": "25.9.3",
        "typescript": "6.0.3",
        "vitest": "5.0.1"
    }
}
